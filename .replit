modules = ["nodejs-24", "postgresql-16", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]
APP_URL = "https://10ede099-f36a-45fd-ab95-9563f0cca0ce-00-3u26dn923lkkz-21jzdhnl.picard.replit.dev"

[userenv.shared]
GMAIL_FROM = "Legend Bucks <ksanti@legendboats.com>"

[userenv.production]
APP_URL = "https://legend-bucks-portal.replit.app"
